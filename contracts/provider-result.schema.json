{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/ProviderResult",
  "$defs": {
    "ProviderResult": {
      "type": "object",
      "properties": {
        "criterion_results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProviderCriterionResult"
          },
          "minItems": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "model_requested": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "model_reported": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "usage": {
          "$ref": "#/$defs/Usage"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "review_reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "required": [
        "criterion_results",
        "provider",
        "model_requested",
        "model_reported",
        "usage",
        "duration_ms",
        "review_reasons"
      ],
      "additionalProperties": false
    },
    "ProviderCriterionResult": {
      "type": "object",
      "properties": {
        "criterion_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "applicability": {
          "enum": [
            "applicable",
            "not_applicable"
          ]
        },
        "answer": {
          "type": [
            "boolean",
            "number",
            "null"
          ],
          "minimum": 0
        },
        "explanation": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Evidence"
          },
          "minItems": 1
        },
        "review_reasons": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      },
      "required": [
        "criterion_id",
        "applicability",
        "answer",
        "explanation",
        "evidence",
        "review_reasons"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "applicability": {
                "const": "not_applicable"
              }
            }
          },
          "then": {
            "properties": {
              "answer": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "answer": {
                "type": [
                  "boolean",
                  "number"
                ]
              }
            }
          }
        }
      ]
    },
    "Evidence": {
      "oneOf": [
        {
          "$ref": "#/$defs/MessageEvidence"
        },
        {
          "$ref": "#/$defs/RangeEvidence"
        }
      ]
    },
    "MessageEvidence": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "message"
        },
        "message_id": {
          "type": "string",
          "pattern": "^m[0-9]{4,}$"
        }
      },
      "required": [
        "kind",
        "message_id"
      ],
      "additionalProperties": false
    },
    "RangeEvidence": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "range"
        },
        "start_message_id": {
          "type": "string",
          "pattern": "^m[0-9]{4,}$"
        },
        "end_message_id": {
          "type": "string",
          "pattern": "^m[0-9]{4,}$"
        }
      },
      "required": [
        "kind",
        "start_message_id",
        "end_message_id"
      ],
      "additionalProperties": false
    },
    "Usage": {
      "type": "object",
      "properties": {
        "request_count": {
          "type": "integer",
          "minimum": 0
        },
        "input_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "output_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "total_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "cached_input_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "reasoning_output_tokens": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "request_count",
        "input_tokens",
        "output_tokens",
        "total_tokens",
        "cached_input_tokens",
        "reasoning_output_tokens"
      ],
      "additionalProperties": false
    }
  }
}
