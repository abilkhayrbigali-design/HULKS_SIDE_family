# Server settings loaded by backend/app/config.py from the repository root.
# Copy to .env locally. Never commit real values.

# Full signed organizer URL, server only. Leave empty in Git.
CQA_DATASET_API_URL=
CQA_DEFAULT_GROUP_ID=DEV

# OpenAI Responses evaluator configuration.
# Requested default; verify account access and benchmark RU/KZ/EN.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
CQA_LLM_TIMEOUT_SECONDS=90
CQA_LLM_MAX_RETRIES=2
CQA_LLM_MAX_OUTPUT_TOKENS=12000
CQA_LLM_REASONING_EFFORT=medium
CQA_EVALUATION_CONCURRENCY=2

# One API process/worker for the initial SQLite + in-process job worker setup.
CQA_DATABASE_URL=sqlite:///./data/private/cqa.sqlite3
CQA_ALLOWED_ORIGINS=http://localhost:5173
# The built frontend is served from this path; relative paths resolve from the repo root.
CQA_FRONTEND_DIST=frontend/dist
# Request summaries: INFO success, WARNING 4xx, ERROR 5xx/late failures.
# Internal diagnostics include repository file:line locations, never exception values.
CQA_LOG_LEVEL=INFO
